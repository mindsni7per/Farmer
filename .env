# Discord Bot & Application Credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here

# Web Server Redirect Settings
REDIRECT_URI=https://your-app-name.up.railway.app/auth/callback
PORT=3000

# Optional: AutoRestock Notification Channel ID
LOG_CHANNEL_ID=your_log_channel_id_here
